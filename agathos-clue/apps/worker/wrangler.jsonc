{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agathos-clue",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" }
    ]
  },
  "d1_databases": [
    {
      "binding": "LOBBY_DB",
      "database_name": "agathos-clue-lobby",
      "database_id": "c6b77943-0182-4d87-906e-9098b7e45bf0",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ],
  "vars": {
    "DISCORD_CLIENT_ID": "1152547279513845811",
    "DISCORD_REDIRECT_URI": "https://agathos-clue.blackhatmagic.workers.dev/auth/callback",
    "ROBOT_STEP_PACE_MS": "1800"
  }
}
